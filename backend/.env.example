# Copy this file to .env and fill in your real key.
# .env is git-ignored and must NEVER be committed.

# Get a free key at https://app.freecurrencyapi.com/register
FREECURRENCY_API_KEY=your_freecurrencyapi_key_here

# Port the NestJS server listens on.
PORT=3000

# development | production. Keep 'development' locally: it is what allows any
# localhost port through CORS. Anything else (including unset) enforces the
# CORS_ORIGINS allowlist only, so a forgotten value fails closed.
NODE_ENV=development

# Comma-separated list of browser origins allowed to call this API.
# Development default is http://localhost:5173 (Vite).
# In production set this to your deployed frontend URL, e.g.
# CORS_ORIGINS=https://your-app.netlify.app
CORS_ORIGINS=http://localhost:5173
