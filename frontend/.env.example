# Copy this file to .env for local development.
#
# This is the URL of OUR OWN NestJS backend. It is NOT a secret - the browser
# has to know it in order to make requests at all.
#
# NEVER put the FreeCurrencyAPI key in this file or in any VITE_ variable.
# Vite substitutes VITE_ values directly into the JavaScript bundle at build
# time, which means anyone can read them in DevTools.

VITE_API_BASE_URL=http://localhost:3000/api
